{
  "name": "python-coverage-action",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action that reports Python coverage on a pull request and fails builds below a patch coverage threshold.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simlab-vs/python-coverage-action"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "pack": "npm run format:check && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
